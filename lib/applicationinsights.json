{
  "connectionString": "${file:/mnt/secrets/prl/app-insights-connection-string}",
  "role": {
    "name": "prl"
  },
  "sampling": {
    "overrides": [
      {
        "telemetryType": "request",
        "attributes": [
          {
            "key": "http.url",
            "value": "https?://[^/]+/health.*",
            "matchType": "regexp"
          }
        ],
        "percentage": 1
      }
    ]
  },
  "preview": {
    "processors": [
      {
        "type": "attribute",
        "actions": [
          {
            "key": "url.full",
            "pattern": "(?<prefix>.*[?&]key=)[^&]+(?<suffix>.*)",
            "replace": "${prefix}REDACTED${suffix}",
            "action": "mask"
          },
          {
            "key": "http.url",
            "pattern": "(?<prefix>.*[?&]key=)[^&]+(?<suffix>.*)",
            "replace": "${prefix}REDACTED${suffix}",
            "action": "mask"
          }
        ]
      }
    ]
  }
}
